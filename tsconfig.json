{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext", "moduleResolution": "Bundler", "resolveJsonModule": true,
    "types": ["vite/client", "node"], "jsx": "react-jsx", "strict": true,
    "noEmit": true, "isolatedModules": true, "skipLibCheck": true
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "tests"]
}
